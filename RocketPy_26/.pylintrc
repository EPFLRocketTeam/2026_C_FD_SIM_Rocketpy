[MASTER]
ignore-patterns=^\.#

[MESSAGES CONTROL]
disable=
    broad-exception-caught,
    duplicate-code,
    fixme,
    implicit-str-concat,
    invalid-name,
    missing-class-docstring,
    missing-function-docstring,
    missing-module-docstring,
    no-else-return,
    redefined-outer-name,
    too-many-arguments,
    too-many-branches,
    too-many-function-args,
    too-many-instance-attributes,
    too-many-locals,
    too-many-positional-arguments,
    too-many-statements,
    too-many-lines,
    unspecified-encoding,
    unused-argument,
    wrong-import-order,
    wrong-import-position,
    use-dict-literal

[FORMAT]
max-line-length=88
